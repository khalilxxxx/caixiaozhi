{
  "name": "caixiaozhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,worker,web \"pnpm --filter @caixiaozhi/api dev\" \"pnpm --filter @caixiaozhi/worker dev\" \"pnpm --filter @caixiaozhi/web dev\"",
    "build": "pnpm -r build",
    "db:migrate": "tsx --conditions=development scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=development scripts/db-seed.ts",
    "db:reset": "tsx --conditions=development scripts/db-reset.ts",
    "typecheck": "pnpm --filter './packages/**' build && pnpm -r typecheck && tsc -p tsconfig.tests.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:agent:real": "tsx --conditions=development scripts/test-agent-real.ts",
    "test:load": "tsx --conditions=development scripts/test-agent-load.ts",
    "test:load:http": "tsx --conditions=development scripts/test-load.ts",
    "format": "prettier --write apps packages scripts tests '*.json' '*.yaml' '.prettierrc.json' infra/compose.yaml",
    "format:check": "prettier --check apps packages scripts tests '*.json' '*.yaml' '.prettierrc.json' infra/compose.yaml",
    "demo:documents": "node apps/web/node_modules/vite/bin/vite.js --config apps/web/vite.document-query.config.ts",
    "build:demo:documents": "node apps/web/node_modules/vite/bin/vite.js build --config apps/web/vite.document-query.config.ts",
    "check:demo:documents": "node node_modules/typescript/bin/tsc -p apps/web/tsconfig.document-query.json --noEmit",
    "demo:srs": "bash scripts/demos/start-srs.command",
    "build:demo:srs": "node apps/web/node_modules/vite/bin/vite.js build --config apps/web/vite.srs-review.config.ts",
    "check:demo:srs": "node node_modules/typescript/bin/tsc -p apps/web/tsconfig.srs-review.json --noEmit",
    "test:demo:srs": "node node_modules/vitest/vitest.mjs run tests/unit/srs-demo.model.spec.ts",
    "demo:agent": "python3 scripts/demos/agno-local.py start",
    "stop:demo:agent": "python3 scripts/demos/agno-local.py stop",
    "status:demo:agent": "python3 scripts/demos/agno-local.py status",
    "build:demo:agent": "node apps/web/node_modules/vite/bin/vite.js build --config apps/web/vite.agent.config.ts",
    "check:demo:agent": "node node_modules/typescript/bin/tsc -p apps/web/tsconfig.agent.json --noEmit",
    "test:demo:agent:backend": "uv run --project apps/agno-service pytest apps/agno-service/tests -q"
  },
  "devDependencies": {
    "@caixiaozhi/action-service": "workspace:*",
    "@caixiaozhi/agent-runtime": "workspace:*",
    "@caixiaozhi/application": "workspace:*",
    "@caixiaozhi/assistant": "workspace:*",
    "@caixiaozhi/business-adapters": "workspace:*",
    "@caixiaozhi/contracts": "workspace:*",
    "@caixiaozhi/demo": "workspace:*",
    "@caixiaozhi/files": "workspace:*",
    "@caixiaozhi/finance": "workspace:*",
    "@caixiaozhi/fixtures": "workspace:*",
    "@caixiaozhi/identity": "workspace:*",
    "@caixiaozhi/insights": "workspace:*",
    "@caixiaozhi/integrations": "workspace:*",
    "@caixiaozhi/jobs": "workspace:*",
    "@caixiaozhi/platform": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "zod": "4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
