    "SEM-TRAVEL-001": {
      "id": "SEM-TRAVEL-001",
      "name": "差旅事由明确性",
      "system": "oa",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 2,
      "description": "检查差旅事由是否明确说明业务事项、业务对象及本次出差要完成的任务。已提供事由但仅写出差、办事、拜访等笼统内容，且活动安排也无法补充业务目标时命中；具体对象、事项与任务齐备时不命中；事由或必要上下文未提供时证据不足。"
    },
    "SEM-TRAVEL-002": {
      "id": "SEM-TRAVEL-002",
      "name": "差旅私人活动风险",
      "system": "oa",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 2,
      "description": "检查差旅申请的事由、行程和活动安排中是否明确包含私人旅游、探亲、个人购物或其他与业务无关的活动，并被纳入本次申请行程或费用。只有明确肯定的安排才命中；未安排旅游、取消探亲、私人活动自费且不计入申请等否定或排除说明不命中；仅有景点地名、可能性或未说明活动性质时证据不足，不得按关键词判断。"
    },
    "SEM-TRAVEL-003": {
      "id": "SEM-TRAVEL-003",
      "name": "行程与业务安排一致性",
      "system": "oa",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 1,
      "description": "对照差旅出发到达城市和日期、业务事由及活动日期地点。明确出现业务活动地点与行程不符、活动日期完全不在到访日期内且无合理说明时命中；地点日期一致或明确合理解释变更时不命中；缺少行程或业务活动地点日期依据时证据不足，不得自行推测交通时间。"
    }
