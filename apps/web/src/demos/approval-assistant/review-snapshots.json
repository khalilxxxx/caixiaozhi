    "SEM-EXPENSE-001": {
      "id": "SEM-EXPENSE-001",
      "name": "业务招待高档消费风险",
      "system": "expense",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 2,
      "description": "招待费用事由中涉及高档消费时，提单和审单时提醒本人。仅根据已提供的事由判断：明确描述已发生或计划安排高档酒水、奢侈食材、娱乐会所等高档消费时命中；未安排、不包含、已取消且不发生费用、引用禁止事项等否定或排除语境不命中；仅有餐厅名称、金额偏高、可能性或模糊套餐而无高档消费事实时证据不足。不得按关键词或编造金额阈值、企业禁令判断。"
    },
    "SEM-EXPENSE-002": {
      "id": "SEM-EXPENSE-002",
      "name": "费用用途与报销事由一致性",
      "system": "expense",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 2,
      "description": "逐项对照费用用途和报销事由。明确费用用于私人事项或与本次业务目标不相容且无合理说明时命中；明细业务用途与事由一致，或有明确的合理业务关联时不命中；缺少具体费用用途、报销事由或关联依据时证据不足。仅文字不同不得认定用途不符。"
    },
    "SEM-EXPENSE-003": {
      "id": "SEM-EXPENSE-003",
      "name": "业务招待信息完整性",
      "system": "expense",
      "origin": "personal",
      "scope": "both",
      "metric": "semantic",
      "effect": "warn",
      "enabled": true,
      "version": 2,
      "description": "对确认属于业务招待的费用，检查是否明确记录招待对象、实际人数和业务目的；事由或明细明确缺失、留空或写待补充其中任一项时命中；三项在已提供信息中齐备时不命中；无法确认是否业务招待或相关资料尚未取得时证据不足。不得根据金额推算人数或虚构招待对象。"
    },
