# 将本文件复制为 .env，并自行生成本地密码。不得提交真实凭据。
# APP_MODE 为 demo、test 或 production。模型密钥不是 T01 必需配置。
APP_MODE=demo
BUSINESS_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
# 可选。默认根据 API_PORT 自动使用本机 API
# API_PROXY_TARGET=http://127.0.0.1:3000

# PostgreSQL。修改密码后同步更新 DATABASE_URL，特殊字符应进行 URL 编码。
POSTGRES_DB=caixiaozhi
POSTGRES_USER=caixiaozhi
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://caixiaozhi:replace-with-local-db-password@127.0.0.1:5432/caixiaozhi

# S3 私有存储。只将服务端持有的密钥写在此文件中。
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=caixiaozhi-private
S3_ACCESS_KEY_ID=replace-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-storage-secret
S3_FORCE_PATH_STYLE=true

# demo 必须显式启用本机演示身份入口。生产强制关闭。
DEMO_ACCESS_ENABLED=false
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=true
# 自行生成至少32字符的会话签名秘密，生产必填
# SESSION_SECRET=
# 真实 dsh 模型配置，只有配置完成后启用实际模型调用
# DSH_API_KEY=
# DSH_MODEL=
# DSH_BASE_URL=https://your-gateway/v1
# DSH_CONTEXT_WINDOW=
# DSH_API_PROTOCOL=openai-completions

# 可选：多个隔离的演示环境使用不同ID；默认值如下。
DEMO_ENVIRONMENT_ID=demo-default
DEMO_TENANT_ID=t-demo

# 5190 独立 Agno 产品。未配置 AGNO_* 时兼容上面的 DSH_* 模型配置。
# AGNO_API_KEY=
# AGNO_BASE_URL=https://api.deepseek.com/v1
# AGNO_MODEL=deepseek-chat
# AGNO_DATA_DIR=本地绝对路径（默认 .runtime/agno-local）
